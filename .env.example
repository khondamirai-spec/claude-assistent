# Local development and testing only.
#   cp .env.example .env && chmod 600 .env
# On Railway this file is NOT used: set Variables with the same names instead.
#
# Comments must stay on their own lines: python-dotenv misreads "KEY=   # comment".

# Bot token from @BotFather (/newbot). Turn on Bot Settings -> Business Mode for the bot.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (ask @userinfobot). Only this account is served.
OWNER_ID=

# false = preview mode: drafted replies are only shown in the logs, nothing is sent.
# true  = replies are sent to people from your account.
AUTO_SEND=false

# Claude subscription token: the sk-ant-oat... value printed by `claude setup-token`.
# Create it once on a computer with a browser; it is valid for 1 year.
# Keep it like a password. Paste it here with an editor, on ONE line (not with echo).
# Left empty: this machine's own `claude` login is used (local testing only).
# Never put an Anthropic API key (sk-ant-api...) here; it is rejected.
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the claude binary. Empty: found on PATH, then ~/.local/bin/claude.
CLAUDE_BIN=

# Claude model (for example sonnet or opus). Empty: the CLI default.
CLAUDE_MODEL=

# Reasoning effort: low, medium, high, xhigh or max. Low is fast and cheap.
CLAUDE_EFFORT=low

# Seconds to wait for one reply before giving up (minimum 1).
CLAUDE_TIMEOUT_SECONDS=120

# When the subscription limit is hit without a known reset time, wait this many minutes (minimum 1).
LIMIT_COOLDOWN_MINUTES=30

# After you write in a chat yourself, the bot stays silent there for this many minutes (0 = off).
OWNER_TAKEOVER_MINUTES=15

# How many recent messages per chat are kept and sent to Claude (minimum 1).
HISTORY_LIMIT=30
